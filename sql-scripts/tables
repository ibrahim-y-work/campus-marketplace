CREATE TABLE users (
    id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
    first_name VARCHAR(50) NOT NULL,
    last_name VARCHAR(50) NOT NULL,
    email VARCHAR(254) UNIQUE NOT NULL,
    phone VARCHAR(20) UNIQUE,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL
);

CREATE TABLE items (
    id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
    name VARCHAR(120) NOT NULL,
    description TEXT NOT NULL,
    itemStatus VARCHAR(20) NOT NULL CHECK (itemStatus IN ('reserved', 'available', 'sold', 'exchanged', 'closed')),
    condition VARCHAR(20) NOT NULL CHECK (condition IN ('poor', 'good', 'excellent')),
    category VARCHAR(20) NOT NULL CHECK (category IN ('calculators', 'books', 'summaries', 'electronics', 'others')),
    owner_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL
);

CREATE TABLE item_options (
    id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
    item_id UUID NOT NULL REFERENCES items(id) ON DELETE CASCADE,
    option_type VARCHAR(20) NOT NULL CHECK (option_type IN ('sell', 'borrow', 'exchange')),
    itemStatus VARCHAR(20) NOT NULL CHECK (itemStatus IN ('available', 'reserved', 'completed', 'closed')),
    price NUMERIC(10, 2) CHECK (price >= 0),
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL,
    
    CONSTRAINT uq_item_option UNIQUE (item_id, option_type)
);
